# Aramaixo Porra Admin — Apache konfigurazioa

Options -Indexes
DirectoryIndex index.php

# api/* eskaerak api.php-ra bideratu (azpi-bidea _path parametroan)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/
    # FastCGI/PHP-FPM-rekin PHP_AUTH_USER ez da automatikoki pasatzen — Authorization header eskuz pasa
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api.php?_path=$1 [QSA,L]
</IfModule>

# Fitxategi sentikorrak blokeatu
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>
<Files "index.html">
    Require all denied
</Files>
<FilesMatch "\.log$">
    Require all denied
</FilesMatch>
