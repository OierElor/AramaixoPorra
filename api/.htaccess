# Aramaixo Porra API — Apache konfigurazioa

Options -Indexes

# db-read.php eta tresna-katalogoa.php ez dira endpoint-ak: beste PHP fitxategiek
# barnetik kargatzen dituzte (require_once). PHPk ez luke iturburua erakutsiko, baina
# zuzeneko sarbidea blokeatzea merkea da.
<Files "db-read.php">
    Require all denied
</Files>
<Files "tresna-katalogoa.php">
    Require all denied
</Files>
